# Copy this file to .env.local and fill in your real values.
# Never commit real credentials. .env* files are gitignored.

# Upstash Redis (via Vercel KV or direct Upstash)
# Option 1: Use Vercel's environment variable names (auto-set when using Vercel KV)
KV_REST_API_URL="https://<your-kv-name>.upstash.io"
KV_REST_API_TOKEN="<your-write-token>"
KV_REST_API_READ_ONLY_TOKEN="<your-read-only-token>"
KV_URL="<redis-url>"
REDIS_URL="<redis-url>"

# Option 2: Use Upstash's standard environment variable names (recommended)
UPSTASH_REDIS_REST_URL="https://<your-kv-name>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-write-token>"

# Admin Authentication - REQUIRED for admin console access
# Set these in Vercel Dashboard → Settings → Environment Variables
ADMIN_USERNAME="your-admin-email@example.com"
ADMIN_PASSWORD="your-secure-password-here"
ADMIN_AUTH_SECRET="generate-with-node-crypto-randomBytes"

# To generate a strong ADMIN_AUTH_SECRET, run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# For production, consider using scrypt-hashed passwords:
# Format: scrypt$<salt-hex>$<hash-hex>
# Generate a hash with Node.js crypto.scryptSync()
